# Bot app registration (Microsoft App ID) used for outbound replies.
AZURE_BOT_CLIENT_ID=<bot client ID>
AZURE_BOT_TENANT_ID=<tenant ID>

# Default auth: client secret (used when federated identity is off).
AZURE_BOT_CLIENT_SECRET=<bot client secret>

# Opt-in AKS workload identity. Set to true only in environments that project
# a federated token file into the pod.
ENABLE_AZURE_BOT_FEDERATED_IDENTITY=false

# Required when ENABLE_AZURE_BOT_FEDERATED_IDENTITY=true.
# AZURE_FEDERATED_TOKEN_FILE=/var/run/secrets/azure/tokens/azure-identity-token

# App log level: debug | info (default) | warn | error
# LOG_LEVEL=debug

# Agents SDK debug namespaces (debug package). Unset = SDK silent.
# DEBUG=agents:*

# Port the service listens on (Azure App Service / AKS sets PORT).
PORT=3978
